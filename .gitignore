# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Pytest / test caches
.pytest_cache/
.coverage
htmlcov/

# Artifacts and operational audit logs
artifacts/
*.log
audit_trail.jsonl
engine/audit_trail.jsonl

# Temporary and scratch files
tmp*
*_helper*.py
*.tmp
*.bak
*.swp

# Environment and secrets
.env
.venv/
env/
venv/

# Explicitly retain the test-only auth helper despite the generic helper ignore rule
!tests/helpers/
!tests/helpers/auth_test_helper.py

# Additional secret and credential protection
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/

# Local configuration and device exports
*.conf
*.backup

# Undesired documentation files
testing.md
*.test.md
test_*.md
final_verification.md
audit.md
implementation.md
*_draft.md

# Additional internal markdown files to keep private
AUDIT_AND_IMPLEMENTATION_PLAN.md
AUTHORIZATION.md
CHANGELOG.md
CONNECTORS.md
FINAL_VERIFICATION.md
LIMITATIONS.md
MODULES.md
OPERATIONS_GUIDE.md
SECURITY.md
SKILL.md
TESTING.md
VENDOR_SUPPORT.md
devices/*.md
examples/*.md
playbooks/*.md
provisioning/**/*.md
quality-control/**/*.md
references/**/*.md
vendors/*.md
wireless-engineering/*.md
